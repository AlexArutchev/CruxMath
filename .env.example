# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY by `npm run seed` to bulk-load content.
# Never expose this to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the seed script reads the built content from (local vault, not in this repo).
CRUX_CONTENT_DIR=../crux-journal

# Google Analytics 4 measurement ID. Optional: leave it unset and no analytics
# tag is rendered at all, which is what a fork of this repo should do rather
# than reporting into someone else's property. Not a secret, since it ships to
# the browser either way; it lives here so it is a deployment choice rather
# than a constant baked into the source.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
