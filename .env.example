# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY by `npm run seed` to bulk-load content.
# Never expose this to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the seed script reads the built content from (local vault, not in this repo).
CRUX_CONTENT_DIR=../crux-journal
